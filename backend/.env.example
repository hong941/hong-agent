# 数据库默认使用 SQLite；如需 PostgreSQL + pgvector 可替换为：
# DATABASE_URL=postgresql+psycopg://smart_hospital:smart_hospital@localhost:5432/smart_hospital
DATABASE_URL=sqlite:///./smart_hospital.db
SECRET_KEY=please-change-this-secret

# 不配置 API Key 时使用本地确定性降级引擎；配置后自动切换为真实模型接口
# 真实 Key 请写入同目录 .env（已被 gitignore），不要提交到仓库
# LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
LLM_STYLE=anthropic
